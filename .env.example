# Database
DATABASE_URL="file:./dev.db"

# JWT / application auth
JWT_SECRET="replace-with-a-long-random-value"

# Empty means same origin. Start the app with node server.js (Socket.IO included).
# A separately hosted signaling server must use a publicly reachable HTTPS URL.
# Do not set localhost here for a public deployment or another device.
NEXT_PUBLIC_SOCKET_URL=""
# Optional path override is normally unnecessary. HTTPS same-origin deployments
# use the Vercel function at /api/socket-io/socket.io automatically.

# WebRTC TURN relay. Provide production TURN credentials for users behind
# symmetric NATs, corporate firewalls, or carrier-grade NAT.
# Multiple URLs may be comma-separated, for example:
# turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
NEXT_PUBLIC_TURN_URLS=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""
